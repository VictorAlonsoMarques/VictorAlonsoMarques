BRAND_NAME=Latido
BASE_URL=https://latido.example.es

# Email (Brevo, Resend o cualquier SMTP)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Latido <alertas@latido.example.es>

# Bot de Telegram (créalo con @BotFather)
TELEGRAM_BOT_TOKEN=

CLOUDFLARE_TUNNEL_TOKEN=

# Stripe: crea dos productos con precio recurrente mensual (Pro 9 €, Agencia 29 €)
# y un webhook a https://TU-DOMINIO/stripe/webhook con los eventos
# checkout.session.completed y customer.subscription.created/updated/deleted.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_AGENCY=
# Ponlo a true si activas Stripe Tax para calcular el IVA automáticamente.
STRIPE_AUTOMATIC_TAX=false
